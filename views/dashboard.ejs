<!DOCTYPE html>
<html lang="en">
  <%- include('./partials/head', { title: 'My Files', cssPath: 'dashboard.css' }) %>
  <body>
    <%- include('./partials/navbar', { user }) %>

    <main class="dashboard">
      <aside class="sidebar">
        <div class="sidebar-heading">Workspace</div>

        <nav class="sidebar-nav">
          <a href="/dashboard" class="sidebar-link active">
            <i data-lucide="layout-dashboard"></i>
            <span>My Files</span>
          </a>
          <a href="/folders" class="sidebar-link">
            <i data-lucide="folder"></i>
            <span>Folders</span>
          </a>
          <a href="/shared" class="sidebar-link">
            <i data-lucide="share-2"></i>
            <span>Shared</span>
          </a>
        </nav>

        <div class="sidebar-bottom">
          <div class="storage-card">
            <div class="storage-heading">
              <span>Storage</span>
              <i data-lucide="hard-drive"></i>
            </div>
            <div class="storage-value">
              <strong><%= storageUsed %></strong>
              <span>of <%= storageLimit %></span>
            </div>
            <div class="storage-track">
              <div class="storage-progress-fill" style="--storage-used: <%= Number(storagePercentage) %>%;"></div>
            </div>
            <p><%= storagePercentage %>% of your storage used</p>
          </div>

          <a href="/account" class="sidebar-link">
            <i data-lucide="settings"></i>
            <span>Account settings</span>
          </a>

          <form action="/logout" method="POST" class="sidebar-link logout-link">
            <button type="submit" class="logout-button">
              <i data-lucide="log-out"></i>
              <span>Log out</span>
            </button>
          </form>
        </div>
      </aside>

      <section class="dashboard-content">
        <header class="dashboard-header">
          <div>
            <p class="eyebrow">YOUR WORKSPACE</p>
            <h1>My Files</h1>
            <p class="header-description">
              Keep your files organized and everything within reach.
            </p>
          </div>

          <div class="header-actions">
            <button class="button button-secondary" type="button" data-modal-open="createFolderModal">
              <i data-lucide="folder-plus"></i>
              New folder
            </button>
            <button class="button button-primary" type="button" data-modal-open="uploadModal">
              <i data-lucide="upload"></i>
              Upload files
            </button>
          </div>
        </header>

        <section class="overview-grid">
          <article class="overview-card">
            <div class="overview-icon folder-icon">
              <i data-lucide="folders"></i>
            </div>
            <div>
              <p>Total folders</p>
              <strong><%= folderCount %></strong>
            </div>
          </article>

          <article class="overview-card">
            <div class="overview-icon file-icon">
              <i data-lucide="files"></i>
            </div>
            <div>
              <p>Total files</p>
              <strong><%= fileCount %></strong>
            </div>
          </article>

          <article class="overview-card">
            <div class="overview-icon shared-icon">
              <i data-lucide="share-2"></i>
            </div>
            <div>
              <p>Shared folders</p>
              <strong><%= sharedFolderCount %></strong>
            </div>
          </article>
        </section>

        <section class="content-section">
          <div class="section-heading">
            <div>
              <h2>Your folders</h2>
              <p>Your folders at the root of My Files.</p>
            </div>
            <a href="/folders" class="text-link">
              View all <i data-lucide="arrow-up-right"></i>
            </a>
          </div>

          <% if (rootFolders.length > 0) { %>
            <div class="folder-grid">
              <% rootFolders.forEach(folder => { %>
                <a href="/folders/<%= folder.id %>" class="folder-card">
                  <div class="folder-card-top">
                    <div class="folder-symbol">
                      <i data-lucide="folder"></i>
                    </div>
                    <i data-lucide="arrow-up-right" class="folder-menu-icon"></i>
                  </div>
                  <h3><%= folder.name %></h3>
                  <p>
                    <%= folder._count?.files ?? 0 %>
                    <%= folder._count?.files === 1 ? 'file' : 'files' %>
                    ·
                    <%= folder._count?.children ?? 0 %>
                    <%= folder._count?.children === 1 ? 'subfolder' : 'subfolders' %>
                  </p>
                </a>
              <% }) %>
            </div>
          <% } else { %>
            <div class="empty-state folder-empty">
              <div class="empty-icon">
                <i data-lucide="folder-plus"></i>
              </div>
              <h3>No folders yet</h3>
              <p>Create your first folder to start organizing your files.</p>
              <button class="text-button" type="button" data-modal-open="createFolderModal">
                Create a folder <i data-lucide="arrow-right"></i>
              </button>
            </div>
          <% } %>
        </section>

        <section class="content-section">
          <div class="section-heading">
            <div>
              <h2>Files in My Files</h2>
              <p>Files stored directly in your root workspace.</p>
            </div>
          </div>

          <% if (rootFiles.length > 0) { %>
            <div class="files-table-wrapper">
              <table class="files-table">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>File size</th>
                    <th>Date added</th>
                    <th><span class="sr-only">Actions</span></th>
                  </tr>
                </thead>
                <tbody>
                  <% rootFiles.forEach(file => { %>
                    <tr>
                      <td>
                        <div class="file-name-cell">
                          <div class="file-type-icon">
                            <i data-lucide="file"></i>
                          </div>
                          <span class="file-name-text" title="<%= file.originalName %>">
                            <%= file.originalName %>
                          </span>
                        </div>
                      </td>
                      <td><%= file.formattedSize %></td>
                      <td><%= file.formattedDate %></td>
                      <td>
                        <div class="file-actions">
                          <a
                            href="/files/<%= file.id %>/download"
                            class="file-action"
                            title="Download"
                            aria-label="Download <%= file.originalName %>"
                          >
                            <i data-lucide="download"></i>
                          </a>

                          <button
                            type="button"
                            class="file-action"
                            title="Rename"
                            aria-label="Rename <%= file.originalName %>"
                            data-modal-open="renameFile-<%= file.id %>"
                          >
                            <i data-lucide="pencil"></i>
                          </button>

                          <a
                            href="/files/<%= file.id %>/move"
                            class="file-action"
                            title="Move"
                            aria-label="Move <%= file.originalName %>"
                          >
                            <i data-lucide="folder-input"></i>
                          </a>

                          <form action="/files/<%= file.id %>/delete" method="POST">
                            <button
                              type="submit"
                              class="file-action file-delete-action"
                              title="Delete"
                              aria-label="Delete <%= file.originalName %>"
                            >
                              <i data-lucide="trash-2"></i>
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>

                    <dialog class="dashboard-modal" id="renameFile-<%= file.id %>">
                      <form action="/files/<%= file.id %>/rename" method="POST" class="modal-content">
                        <div class="modal-header">
                          <div>
                            <p class="eyebrow">FILE MANAGEMENT</p>
                            <h2>Rename file</h2>
                          </div>
                          <button type="button" class="modal-close" data-modal-close aria-label="Close">
                            <i data-lucide="x"></i>
                          </button>
                        </div>

                        <label for="file-name-<%= file.id %>">File name</label>
                        <input
                          type="text"
                          id="file-name-<%= file.id %>"
                          name="name"
                          value="<%= file.originalName %>"
                          maxlength="255"
                          required
                        >

                        <div class="modal-actions">
                          <button type="button" class="button button-secondary" data-modal-close>
                            Cancel
                          </button>
                          <button type="submit" class="button button-primary">
                            Save changes
                          </button>
                        </div>
                      </form>
                    </dialog>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="empty-state files-empty">
              <div class="empty-icon">
                <i data-lucide="file-up"></i>
              </div>
              <h3>No files in My Files</h3>
              <p>Files uploaded directly to your workspace will appear here.</p>
              <button class="text-button" type="button" data-modal-open="uploadModal">
                Upload a file <i data-lucide="arrow-right"></i>
              </button>
            </div>
          <% } %>
        </section>
      </section>
    </main>

    <dialog
      class="dashboard-modal"
      id="createFolderModal"
      data-open-on-load="<%= typeof folderError !== 'undefined' && folderError ? 'true' : 'false' %>"
    >
      <form action="/folders" method="POST" class="modal-content">
        <div class="modal-header">
          <div>
            <p class="eyebrow">ORGANIZE YOUR FILES</p>
            <h2>Create a folder</h2>
          </div>
          <button type="button" class="modal-close" data-modal-close aria-label="Close">
            <i data-lucide="x"></i>
          </button>
        </div>

        <% if (typeof folderError !== 'undefined' && folderError) { %>
          <p class="modal-error"><%= folderError %></p>
        <% } %>

        <label for="folderName">Folder name</label>
        <input
          type="text"
          id="folderName"
          name="name"
          placeholder="e.g. Personal documents"
          maxlength="100"
          value="<%= typeof folderName !== 'undefined' ? folderName : '' %>"
          required
        >

        <div class="modal-actions">
          <button type="button" class="button button-secondary" data-modal-close>Cancel</button>
          <button type="submit" class="button button-primary">Create folder</button>
        </div>
      </form>
    </dialog>

    <dialog class="dashboard-modal" id="uploadModal">
      <form action="/files/upload" method="POST" enctype="multipart/form-data" class="modal-content">
        <div class="modal-header">
          <div>
            <p class="eyebrow">ADD TO YOUR WORKSPACE</p>
            <h2>Upload a file</h2>
          </div>
          <button type="button" class="modal-close" data-modal-close aria-label="Close">
            <i data-lucide="x"></i>
          </button>
        </div>

        <label for="fileUpload">Choose a file</label>
        <div class="upload-area">
          <i data-lucide="cloud-upload"></i>
          <p>Select a file from your device</p>
          <span>Upload one file at a time</span>
          <input type="file" id="fileUpload" name="file" required>
        </div>

        <label for="uploadFolder">Upload location</label>
        <select id="uploadFolder" name="folderId">
          <option value="">My Files</option>
          <% rootFolders.forEach(folder => { %>
            <option value="<%= folder.id %>"><%= folder.name %></option>
          <% }) %>
        </select>

        <div class="modal-actions">
          <button type="button" class="button button-secondary" data-modal-close>Cancel</button>
          <button type="submit" class="button button-primary">Upload</button>
        </div>
      </form>
    </dialog>

    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
      lucide.createIcons();

      document.querySelectorAll('[data-modal-open]').forEach(button => {
        button.addEventListener('click', () => {
          document.getElementById(button.dataset.modalOpen)?.showModal();
        });
      });

      document.querySelectorAll('[data-modal-close]').forEach(button => {
        button.addEventListener('click', () => {
          button.closest('dialog')?.close();
        });
      });

      document.querySelectorAll('.dashboard-modal').forEach(modal => {
        modal.addEventListener('click', event => {
          if (event.target === modal) modal.close();
        });

        if (modal.dataset.openOnLoad === 'true') modal.showModal();
      });
    </script>
  </body>
</html>
