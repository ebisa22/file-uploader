 <!DOCTYPE html>
<html lang="en">
  <%- include('./partials/head', {
    title: typeof folder !== 'undefined' ? folder.name : 'My Folders',
    cssPath: 'folders.css'
  }) %>
  <body>
    <%- include('./partials/navbar', { user }) %>

    <%
      const isSubFolderPage = typeof folder !== 'undefined';
      const currentFolders = folders || [];
      const currentFiles = typeof files !== 'undefined' ? files : [];
    %>

    <main class="folders-page">
      <header class="folders-header">
        <div class="folders-heading">
          <a href="/dashboard" class="back-link">
            <i data-lucide="arrow-left"></i>
            Dashboard
          </a>

          <% if (isSubFolderPage) { %>
            <nav class="breadcrumb" aria-label="Breadcrumb">
              <a href="/folders">My Folders</a>
              <i data-lucide="chevron-right"></i>
              <span><%= folder.name %></span>
            </nav>
          <% } %>

          <div class="page-title-group">
            <p class="eyebrow">YOUR STORAGE</p>
            <h1><%= isSubFolderPage ? folder.name : 'My Folders' %></h1>
            <p class="page-description">
              <%= isSubFolderPage
                ? 'Manage the folders and files stored here.'
                : 'Keep your documents organized in one place.' %>
            </p>
          </div>
        </div>

        <% if (isSubFolderPage) { %>
          <div class="current-folder-actions">
            <button
              type="button"
              class="action-button"
              data-modal-open="renameCurrentFolder"
            >
              <i data-lucide="pencil"></i>
              Rename
            </button>
  <a href="/folders/<%= folder.id %>/move" class="action-button">
  <i data-lucide="folder-input"></i>
  Move
</a>
            <button
              type="button"
              class="action-button action-delete"
              data-modal-open="deleteCurrentFolder"
            >
              <i data-lucide="trash-2"></i>
              Delete
            </button>
          </div>
        <% } else { %>
          <div class="folder-count">
            <span><%= folderCount %></span>
            <small><%= folderCount === 1 ? 'Folder' : 'Folders' %></small>
          </div>
        <% } %>
      </header>
      <section class="folder-create-section">
        <form action="/folders" method="POST" class="create-folder-form">
          <% if (isSubFolderPage) { %>
            <input type="hidden" name="parentId" value="<%= folder.id %>">
          <% } %>

          <label class="create-folder-input">
            <i data-lucide="folder-plus"></i>
            <input
              type="text"
              name="name"
              placeholder="<%= isSubFolderPage ? 'Name your new subfolder' : 'Name your new folder' %>"
              maxlength="100"
              required
              
            >
          </label>

          <button type="submit" class="create-button">
            <i data-lucide="plus"></i>
            <%= isSubFolderPage ? 'Create subfolder' : 'Create folder' %>
          </button>
        </form>
      </section>

      <section class="folder-section">
        <div class="section-heading">
          <div>
            <h2><%= isSubFolderPage ? 'Subfolders' : 'All folders' %></h2>
            <p>
              <%= currentFolders.length %>
              <%= currentFolders.length === 1 ? 'folder' : 'folders' %>
            </p>
          </div>
        </div>

        <% if (currentFolders.length > 0) { %>
          <div class="folder-grid">
            <% currentFolders.forEach(item => { %>
              <article class="folder-card">
                <a href="/folders/<%= item.id %>" class="folder-open">
                  <div class="folder-card-top">
                    <div class="folder-icon">
                      <i data-lucide="folder"></i>
                    </div>
                    <i data-lucide="arrow-up-right" class="folder-arrow"></i>
                  </div>

                  <h3><%= item.name %></h3>

                  <div class="folder-meta">
                    <span>
                      <i data-lucide="files"></i>
                      <%= item._count ? item._count.files : 0 %>
                      files
                    </span>
                    <span>
                      <i data-lucide="folder"></i>
                      <%= item._count ? item._count.children : 0 %>
                      subfolders
                    </span>
                  </div>
                </a>

                <div class="folder-card-actions">
                  <button
                    type="button"
                    class="icon-button"
                    aria-label="Rename <%= item.name %>"
                    title="Rename"
                    data-modal-open="renameFolder-<%= item.id %>"
                  >
                    <i data-lucide="pencil"></i>
                  </button>
                  <a href="/folders/<%= item.id %>/move" class="icon-button" title="Move" aria-label="Move <%= item.name %>">
  <i data-lucide="folder-input"></i>
</a>
                  <button
                    type="button"
                    class="icon-button delete-icon-button"
                    aria-label="Delete <%= item.name %>"
                    title="Delete"
                    data-modal-open="deleteFolder-<%= item.id %>"
                  >
                    <i data-lucide="trash-2"></i>
                  </button>
                </div>
              </article>
              <!-- Name you-->
              <dialog class="folder-modal" id="renameFolder-<%= item.id %>">
                <form
                  action="/folders/<%= item.id %>/rename"
                  method="POST"
                  class="modal-content"
                >
                  <div class="modal-heading">
                    <div class="modal-icon">
                      <i data-lucide="pencil"></i>
                    </div>
                    <button
                      type="button"
                      class="modal-close"
                      data-modal-close
                      aria-label="Close"
                    >
                      <i data-lucide="x"></i>
                    </button>
                  </div>

                  <h2>Rename folder</h2>
                  <p class="modal-description">
                    Choose a new name for "<%= item.name %>".
                  </p>

                  <label for="rename-input-<%= item.id %>">Folder name</label>
                  <input
                    id="rename-input-<%= item.id %>"
                    type="text"
                    name="name"
                    value="<%= item.name %>"
                    maxlength="100"
                    required
                  >

                  <div class="modal-actions">
                    <button type="button" class="cancel-button" data-modal-close>
                      Cancel
                    </button>
                    <button type="submit" class="create-button">
                      Save changes
                    </button>
                  </div>
                </form>
              </dialog>

              <dialog class="folder-modal" id="deleteFolder-<%= item.id %>">
                <form
                  action="/folders/<%= item.id %>/delete"
                  method="POST"
                  class="modal-content"
                >
                  <div class="modal-heading">
                    <div class="modal-icon modal-icon-danger">
                      <i data-lucide="trash-2"></i>
                    </div>
                    <button
                      type="button"
                      class="modal-close"
                      data-modal-close
                      aria-label="Close"
                    >
                      <i data-lucide="x"></i>
                    </button>
                  </div>

                  <h2>Delete folder?</h2>
                  <p class="modal-description">
                    Are you sure you want to delete "<%= item.name %>"?
                    Its subfolders and stored files will also be affected.
                  </p>

                  <div class="modal-actions">
                    <button type="button" class="cancel-button" data-modal-close>
                      Cancel
                    </button>
                    <button type="submit" class="confirm-delete-button">
                      Delete folder
                    </button>
                  </div>
                </form>
              </dialog>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state">
            <div class="empty-icon">
              <i data-lucide="folder-open"></i>
            </div>
            <h3><%= isSubFolderPage ? 'No subfolders yet' : 'No folders yet' %></h3>
            <p>
              <%= isSubFolderPage
                ? 'Create a subfolder to organize the contents of this folder.'
                : 'Create your first folder to start organizing your files.' %>
            </p>
          </div>
        <% } %>
      </section>

      <% if (isSubFolderPage) { %>
        <section class="folder-section files-section">
          <div class="section-heading">
            <div>
              <h2>Files</h2>
              <p>
                <%= currentFiles.length %>
                <%= currentFiles.length === 1 ? 'file' : 'files' %>
              </p>
            </div>
          </div>

          <% if (currentFiles.length > 0) { %>
            <div class="file-list">
              <% currentFiles.forEach(file => { %>
                <div class="file-row">
                  <div class="file-icon">
                    <i data-lucide="file"></i>
                  </div>

                  <div class="file-details">
                    <h3><%= file.originalName %></h3>
                    <p><%= file.mimeType %></p>
                  </div>

                  <span class="file-size">
                    <%= (Number(file.size) / (1024 * 1024)).toFixed(2) %> MB
                  </span>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="empty-state file-empty-state">
              <div class="empty-icon">
                <i data-lucide="files"></i>
              </div>
              <h3>No files in this folder</h3>
              <p>Files uploaded to this folder will appear here.</p>
            </div>
          <% } %>
        </section>

        <dialog class="folder-modal" id="renameCurrentFolder">
          <form
            action="/folders/<%= folder.id %>/rename"
            method="POST"
            class="modal-content"
          >
            <div class="modal-heading">
              <div class="modal-icon">
                <i data-lucide="pencil"></i>
              </div>
              <button
                type="button"
                class="modal-close"
                data-modal-close
                aria-label="Close"
              >
                <i data-lucide="x"></i>
              </button>
            </div>

            <h2>Rename folder</h2>
            <p class="modal-description">
              Choose a new name for "<%= folder.name %>".
            </p>

            <label for="rename-current-input">Folder name</label>
            <input
              id="rename-current-input"
              type="text"
              name="name"
              value="<%= folder.name %>"
              maxlength="100"
              required
            >

            <div class="modal-actions">
              <button type="button" class="cancel-button" data-modal-close>
                Cancel
              </button>
              <button type="submit" class="create-button">
                Save changes
              </button>
            </div>
          </form>
        </dialog>

        <dialog class="folder-modal" id="deleteCurrentFolder">
          <form
            action="/folders/<%= folder.id %>/delete"
            method="POST"
            class="modal-content"
          >
            <div class="modal-heading">
              <div class="modal-icon modal-icon-danger">
                <i data-lucide="trash-2"></i>
              </div>
              <button
                type="button"
                class="modal-close"
                data-modal-close
                aria-label="Close"
              >
                <i data-lucide="x"></i>
              </button>
            </div>

            <h2>Delete folder?</h2>
            <p class="modal-description">
              Are you sure you want to delete "<%= folder.name %>"?
              Its subfolders and stored files will also be affected.
            </p>

            <div class="modal-actions">
              <button type="button" class="cancel-button" data-modal-close>
                Cancel
              </button>
              <button type="submit" class="confirm-delete-button">
                Delete folder
              </button>
            </div>
          </form>
        </dialog>
      <% } %>
    </main>

    <%- include('./partials/footer') %>

    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
      lucide.createIcons();

      document.querySelectorAll('[data-modal-open]').forEach(button => {
        button.addEventListener('click', () => {
          const modal = document.getElementById(button.dataset.modalOpen);
          if (modal) modal.showModal();
        });
      });

      document.querySelectorAll('[data-modal-close]').forEach(button => {
        button.addEventListener('click', () => {
          button.closest('dialog')?.close();
        });
      });

      document.querySelectorAll('.folder-modal').forEach(modal => {
        modal.addEventListener('click', event => {
          if (event.target === modal) modal.close();
        });
      });
    </script>
  </body>
</html>