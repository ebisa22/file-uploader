 
<!DOCTYPE html>
<html lang="en">
  <%- include('./partials/head', {
    title: typeof folder !== 'undefined' ? folder.name : 'My Folders',
    cssPath: 'folders.css'
  }) %>
  <body>
    <%- include('./partials/navbar', { user }) %>

    <%
      const isSubFolderPage = typeof folder !== 'undefined' && folder !== null;
      const currentFolders = folders || [];
      const currentFiles = files || [];
    %>

    <main class="folders-page">
      <header class="folders-header">
        <div class="folders-heading">
          <a href="/dashboard" class="back-link">
            <i data-lucide="arrow-left"></i>
            Dashboard
          </a>

          <% if (isSubFolderPage) { %>
            <nav class="breadcrumb" aria-label="Breadcrumb">
              <a href="/folders">My Files</a>
              <i data-lucide="chevron-right"></i>
              <span><%= folder.name %></span>
            </nav>
          <% } %>

          <div class="page-title-group">
            <p class="eyebrow">YOUR STORAGE</p>
            <h1><%= isSubFolderPage ? folder.name : 'My Folders' %></h1>
            <p class="page-description">
              <%= isSubFolderPage
                ? 'Manage the folders and files stored here.'
                : 'Keep your documents organized in one place.' %>
            </p>
          </div>
        </div>

        <% if (isSubFolderPage) { %>
          <div class="current-folder-actions">
            <button
              type="button"
              class="action-button"
              data-modal-open="renameCurrentFolder"
            >
              <i data-lucide="pencil"></i>
              Rename
            </button>

            <a href="/folders/<%= folder.id %>/move" class="action-button">
              <i data-lucide="folder-input"></i>
              Move
            </a>

            <form action="/folders/<%= folder.id %>/delete" method="POST">
              <button type="submit" class="action-button action-delete">
                <i data-lucide="trash-2"></i>
                Delete
              </button>
            </form>
          </div>
        <% } else { %>
          <div class="folder-count">
            <span><%= folderCount %></span>
            <small><%= folderCount === 1 ? 'Folder' : 'Folders' %></small>
          </div>
        <% } %>
      </header>

      <section class="folder-create-section">
        <form action="/folders" method="POST" class="create-folder-form">
          <% if (isSubFolderPage) { %>
            <input type="hidden" name="parentId" value="<%= folder.id %>">
          <% } %>

          <label class="create-folder-input">
            <i data-lucide="folder-plus"></i>
            <input
              type="text"
              name="name"
              placeholder="<%= isSubFolderPage ? 'Name your new subfolder' : 'Name your new folder' %>"
              maxlength="100"
              required
            >
          </label>

          <button type="submit" class="create-button">
            <i data-lucide="plus"></i>
            <%= isSubFolderPage ? 'Create subfolder' : 'Create folder' %>
          </button>
        </form>
      </section>

      <section class="folder-section">
        <div class="section-heading">
          <div>
            <h2><%= isSubFolderPage ? 'Subfolders' : 'Folders' %></h2>
            <p>
              <%= currentFolders.length %>
              <%= currentFolders.length === 1 ? 'folder' : 'folders' %>
            </p>
          </div>
        </div>

        <% if (currentFolders.length > 0) { %>
          <div class="folder-grid">
            <% currentFolders.forEach(item => { %>
              <article class="folder-card">
                <a href="/folders/<%= item.id %>" class="folder-open">
                  <div class="folder-card-top">
                    <div class="folder-icon">
                      <i data-lucide="folder"></i>
                    </div>
                    <i data-lucide="arrow-up-right" class="folder-arrow"></i>
                  </div>

                  <h3><%= item.name %></h3>

                  <div class="folder-meta">
                    <span>
                      <i data-lucide="files"></i>
                      <%= item._count?.files ?? 0 %> files
                    </span>
                    <span>
                      <i data-lucide="folder"></i>
                      <%= item._count?.children ?? 0 %> subfolders
                    </span>
                  </div>
                </a>

                <div class="folder-card-actions">
                  <button
                    type="button"
                    class="icon-button"
                    aria-label="Rename <%= item.name %>"
                    title="Rename"
                    data-modal-open="renameFolder-<%= item.id %>"
                  >
                    <i data-lucide="pencil"></i>
                  </button>

                  <a
                    href="/folders/<%= item.id %>/move"
                    class="icon-button"
                    title="Move"
                    aria-label="Move <%= item.name %>"
                  >
                    <i data-lucide="folder-input"></i>
                  </a>

                  <form action="/folders/<%= item.id %>/delete" method="POST">
                    <button
                      type="submit"
                      class="icon-button delete-icon-button"
                      title="Delete"
                      aria-label="Delete <%= item.name %>"
                    >
                      <i data-lucide="trash-2"></i>
                    </button>
                  </form>
                </div>
              </article>

              <dialog class="folder-modal" id="renameFolder-<%= item.id %>">
                <form action="/folders/<%= item.id %>/rename" method="POST" class="modal-content">
                  <div class="modal-heading">
                    <div class="modal-icon">
                      <i data-lucide="pencil"></i>
                    </div>
                    <button type="button" class="modal-close" data-modal-close aria-label="Close">
                      <i data-lucide="x"></i>
                    </button>
                  </div>

                  <h2>Rename folder</h2>
                  <p class="modal-description">
                    Choose a new name for "<%= item.name %>".
                  </p>

                  <label for="rename-folder-<%= item.id %>">Folder name</label>
                  <input
                    id="rename-folder-<%= item.id %>"
                    type="text"
                    name="name"
                    value="<%= item.name %>"
                    maxlength="100"
                    required
                  >

                  <div class="modal-actions">
                    <button type="button" class="cancel-button" data-modal-close>Cancel</button>
                    <button type="submit" class="create-button">Save changes</button>
                  </div>
                </form>
              </dialog>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state">
            <div class="empty-icon">
              <i data-lucide="folder-open"></i>
            </div>
            <h3><%= isSubFolderPage ? 'No subfolders yet' : 'No folders yet' %></h3>
            <p>
              <%= isSubFolderPage
                ? 'Create a subfolder to organize the contents of this folder.'
                : 'Create your first folder to start organizing your files.' %>
            </p>
          </div>
        <% } %>
      </section>

      <section class="folder-section files-section">
        <div class="section-heading">
          <div>
            <h2><%= isSubFolderPage ? 'Files in this folder' : 'Files in My Files' %></h2>
            <p>
              <%= currentFiles.length %>
              <%= currentFiles.length === 1 ? 'file' : 'files' %>
            </p>
          </div>
        </div>

        <div class="folder-upload-section">
          <form
            action="/files/upload"
            method="POST"
            enctype="multipart/form-data"
            class="folder-upload-form"
          >
            <% if (isSubFolderPage) { %>
              <input type="hidden" name="folderId" value="<%= folder.id %>">
            <% } %>
            <label for="folderFileUpload">
              <i data-lucide="upload"></i>
              Upload a file to <%= isSubFolderPage ? folder.name : 'My Files' %>
            </label>
            <input type="file" id="folderFileUpload" name="file" required>
            <button type="submit" class="create-button">
              Upload file
            </button>
          </form>
        </div>

        <% if (currentFiles.length > 0) { %>
          <div class="file-list">
            <% currentFiles.forEach(file => { %>
              <div class="file-row">
                <div class="file-icon">
                  <i data-lucide="file"></i>
                </div>

                <div class="file-details">
                  <h3 title="<%= file.originalName %>"><%= file.originalName %></h3>
                  <p><%= file.mimeType %></p>
                </div>

                <span class="file-size"><%= file.formattedSize %></span>

                <div class="file-actions">
                  <a
                    href="/files/<%= file.id %>/download"
                    class="icon-button"
                    title="Download"
                    aria-label="Download <%= file.originalName %>"
                  >
                    <i data-lucide="download"></i>
                  </a>

                  <button
                    type="button"
                    class="icon-button"
                    title="Rename"
                    aria-label="Rename <%= file.originalName %>"
                    data-modal-open="renameFile-<%= file.id %>"
                  >
                    <i data-lucide="pencil"></i>
                  </button>

                  <a
                    href="/files/<%= file.id %>/move"
                    class="icon-button"
                    title="Move"
                    aria-label="Move <%= file.originalName %>"
                  >
                    <i data-lucide="folder-input"></i>
                  </a>

                  <form action="/files/<%= file.id %>/delete" method="POST">
                    <button
                      type="submit"
                      class="icon-button delete-icon-button"
                      title="Delete"
                      aria-label="Delete <%= file.originalName %>"
                    >
                      <i data-lucide="trash-2"></i>
                    </button>
                  </form>
                </div>
              </div>

              <dialog class="folder-modal" id="renameFile-<%= file.id %>">
                <form action="/files/<%= file.id %>/rename" method="POST" class="modal-content">
                  <div class="modal-heading">
                    <div class="modal-icon">
                      <i data-lucide="pencil"></i>
                    </div>
                    <button type="button" class="modal-close" data-modal-close aria-label="Close">
                      <i data-lucide="x"></i>
                    </button>
                  </div>

                  <h2>Rename file</h2>
                  <p class="modal-description">
                    Change the displayed name of "<%= file.originalName %>".
                  </p>

                  <label for="rename-file-<%= file.id %>">File name</label>
                  <input
                    id="rename-file-<%= file.id %>"
                    type="text"
                    name="name"
                    value="<%= file.originalName %>"
                    maxlength="255"
                    required
                  >

                  <div class="modal-actions">
                    <button type="button" class="cancel-button" data-modal-close>Cancel</button>
                    <button type="submit" class="create-button">Save changes</button>
                  </div>
                </form>
              </dialog>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state file-empty-state">
            <div class="empty-icon">
              <i data-lucide="files"></i>
            </div>
            <h3>No files here yet</h3>
            <p>Upload a file and it will appear here.</p>
          </div>
        <% } %>
      </section>

      <% if (isSubFolderPage) { %>
        <dialog class="folder-modal" id="renameCurrentFolder">
          <form action="/folders/<%= folder.id %>/rename" method="POST" class="modal-content">
            <div class="modal-heading">
              <div class="modal-icon">
                <i data-lucide="pencil"></i>
              </div>
              <button type="button" class="modal-close" data-modal-close aria-label="Close">
                <i data-lucide="x"></i>
              </button>
            </div>

            <h2>Rename folder</h2>
            <p class="modal-description">
              Choose a new name for "<%= folder.name %>".
            </p>

            <label for="rename-current-folder">Folder name</label>
            <input
              id="rename-current-folder"
              type="text"
              name="name"
              value="<%= folder.name %>"
              maxlength="100"
              required
            >

            <div class="modal-actions">
              <button type="button" class="cancel-button" data-modal-close>Cancel</button>
              <button type="submit" class="create-button">Save changes</button>
            </div>
          </form>
        </dialog>
      <% } %>
    </main>

    <%- include('./partials/footer') %>

    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
      lucide.createIcons();

      document.querySelectorAll('[data-modal-open]').forEach(button => {
        button.addEventListener('click', () => {
          document.getElementById(button.dataset.modalOpen)?.showModal();
        });
      });

      document.querySelectorAll('[data-modal-close]').forEach(button => {
        button.addEventListener('click', () => {
          button.closest('dialog')?.close();
        });
      });

      document.querySelectorAll('.folder-modal').forEach(modal => {
        modal.addEventListener('click', event => {
          if (event.target === modal) modal.close();
        });
      });
    </script>
  </body>
</html>
