 
<!DOCTYPE html>
<html lang="en">
  <%- include('./partials/head', { title: 'Shared Folders', cssPath: 'shared.css' }) %>
  <body>
    <%- include('./partials/navbar', { user }) %>

    <main class="shared-page">
      <header class="shared-header">
        <div>
          <p class="eyebrow">SHARING</p>
          <h1>Shared folders</h1>
          <p>Manage the folders you've shared with others.</p>
        </div>
      </header>

      <% if (shareError) { %>
        <div class="shared-alert">
          <%= shareError %>
        </div>
      <% } %>

      <section class="create-share-card">
        <div class="section-heading">
          <div>
            <h2>Create a share link</h2>
            <p>Choose a folder and decide when its link should expire.</p>
          </div>
        </div>

        <% if (folders.length === 0) { %>
          <p class="empty-hint">
            You don't have any folders to share yet.
            <a href="/folders">Create a folder</a> first.
          </p>
        <% } else { %>
          <form action="/shared" method="POST" class="share-form">
            <div class="form-group">
              <label for="folderId">Folder</label>
              <select name="folderId" id="folderId" required>
                <option value="">Choose a folder</option>
                <% folders.forEach(folder => { %>
                  <option
                    value="<%= folder.id %>"
                    <%= formValues?.folderId == folder.id ? 'selected' : '' %>
                  >
                    <%= folder.path %>
                  </option>
                <% }) %>
              </select>
              <% if (formErrors?.folderId) { %>
                <small class="field-error"><%= formErrors.folderId.msg %></small>
              <% } %>
            </div>

            <div class="form-group">
              <label for="expiresAt">Expiration date</label>
              <input
                type="datetime-local"
                name="expiresAt"
                id="expiresAt"
                value="<%= formValues?.expiresAt || '' %>"
                required
              >
              <% if (formErrors?.expiresAt) { %>
                <small class="field-error"><%= formErrors.expiresAt.msg %></small>
              <% } %>
            </div>

            <button type="submit" class="create-share-button">
              <i data-lucide="link"></i>
              Create share link
            </button>
          </form>
        <% } %>
      </section>

      <section class="shares-section">
        <div class="section-heading">
          <div>
            <h2>Your share links</h2>
            <p>Links you've created for your folders.</p>
          </div>
          <span class="share-count"><%= sharedFolders.length %> links</span>
        </div>

        <% if (sharedFolders.length === 0) { %>
          <div class="empty-shares">
            <div class="empty-icon">
              <i data-lucide="link"></i>
            </div>
            <h3>No shared folders yet</h3>
            <p>When you create a share link, it will appear here.</p>
          </div>
        <% } else { %>
          <div class="shares-list">
            <% sharedFolders.forEach(share => { %>
              <%
                const isRevoked = share.revokedAt !== null;
                const isExpired = new Date(share.expiresAt) <= new Date();
                const status = isRevoked ? 'Revoked' : isExpired ? 'Expired' : 'Active';
              %>

              <article class="share-card">
                <div class="share-main">
                  <div class="share-icon">
                    <i data-lucide="folder"></i>
                  </div>

                  <div class="share-info">
                    <h3><%= share.folder.name %></h3>
                    <p>Created <%= share.formattedDate %></p>
                  </div>
                </div>

                <div class="share-details">
                  <div class="share-expiration">
                    <span>Expires</span>
                    <strong><%= share.formattedExpiry %></strong>
                  </div>

                  <span class="share-status <%= status.toLowerCase() %>">
                    <%= status %>
                  </span>
                </div>

                <div class="share-actions">
                  <% if (status === 'Active') { %>
                    <a
                      href="/share/<%= share.token %>"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="open-share-button"
                    >
                      <i data-lucide="external-link"></i>
                      Open
                    </a>

                    <button
                      type="button"
                      class="copy-share-button"
                      data-share-url="/share/<%= share.token %>"
                    >
                      <i data-lucide="copy"></i>
                      Copy link
                    </button>

                    <form action="/shared/<%= share.id %>/revoke" method="POST">
                      <button type="submit" class="revoke-button">
                        <i data-lucide="x-circle"></i>
                        Revoke
                      </button>
                    </form>
                  <% } %>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>
    </main>

    <script>
      document.querySelectorAll('.copy-share-button').forEach(button => {
        button.addEventListener('click', async () => {
          const url = new URL(button.dataset.shareUrl, window.location.origin).href;

          try {
            await navigator.clipboard.writeText(url);
            button.innerHTML = '<i data-lucide="check"></i> Copied';
            lucide.createIcons();
          } catch (err) {
            console.error(err);
          }
        });
      });

      lucide.createIcons();
    </script>
  </body>
</html>
